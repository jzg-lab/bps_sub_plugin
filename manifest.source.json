{
  "name": "BPS Sub Plugin",
  "description": "把 OpenAI OAuth 账号的请求改走 OpenAI basispoints 端点（开发中：支持不带工具的对话请求）",
  "author": "jzg-lab",
  "requires": {
    "sub2api": ">=0.2.8 <0.3.0",
    "recommended_sub2api_version": "0.2.8",
    "tested_sub2api_versions": ["0.2.8"],
    "plugin_protocol": 1,
    "transport_api": 1,
    "ui_bridge": 1
  },
  "capabilities": [
    {
      "id": "openai.oauth.outbound_transport.v1",
      "platform": "openai",
      "account_type": "oauth"
    }
  ],
  "targets": ["linux-amd64", "linux-arm64", "windows-amd64"],
  "ui": {
    "entrypoint": "ui/index.html"
  }
}
